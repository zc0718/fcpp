# Global configuration
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
MaxEmptyLinesToKeep: 3

# Keep 2-blank-line module split rule intact (MaxEmptyLinesToKeep >= 2)
# Close docstring re-format
ReflowComments: false
SortIncludes: false

---
# C++ (applies to .h/.hpp/.cpp — clang-format treats .h as C++)
Language: Cpp
BreakBeforeBraces: Attach
PointerAlignment: Left
Standard: c++17

---
# C (applies to .c)
Language: C
BreakBeforeBraces: Attach
PointerAlignment: Right
